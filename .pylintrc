[MAIN]
# make sure tests/ resolves science_mode_4 against the local src/ package
# instead of whatever version happens to be installed in site-packages
init-hook='import sys; sys.path.insert(0, "src")'
max-line-length=150
max-attributes=15
max-branches=15

[DESIGN]
max-statements=100
max-locals = 20
max-args = 6
max-positional-arguments = 6

[STRING]
check-quote-consistency=yes

[MESSAGES CONTROL]
disable=too-few-public-methods

[SIMILARITIES]
min-similarity-lines=50